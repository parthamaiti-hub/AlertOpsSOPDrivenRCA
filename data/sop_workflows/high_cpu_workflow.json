{
  "sop_id": "SOP_HIGH_CPU",
  "alert_identifier": {
    "application": "order-service",
    "domain": "infrastructure",
    "category": "performance",
    "severity": ["critical"],
    "sop_identifier_keys": []
  },
  "triaging_steps": [
    {
      "step_id": 1,
      "action": "Query application logs for error patterns",
      "tool": "splunk_query",
      "tool_params": {
        "query": "index=app_logs host={host} level=ERROR earliest=-1h",
        "time_range": "1h"
      }
    },
    {
      "step_id": 2,
      "action": "Check CPU utilization trend",
      "tool": "prometheus_query",
      "tool_params": {
        "query": "rate(process_cpu_seconds_total{instance='{host}'}[5m])",
        "step": "60s",
        "duration": "1h"
      }
    },
    {
      "step_id": 3,
      "action": "Check request latency p99",
      "tool": "prometheus_query",
      "tool_params": {
        "query": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket{service='{application}'}[5m]))",
        "step": "60s",
        "duration": "1h"
      }
    },
    {
      "step_id": 4,
      "action": "Verify service health",
      "tool": "health_check",
      "tool_params": {
        "url": "https://{host}:8080/health",
        "timeout": 5
      }
    }
  ],
  "remediation_steps": [],
  "communication_steps": [
    {
      "step_id": 5,
      "action": "Send RCA notification to ops team via Teams",
      "tool": "teams_message",
      "tool_params": {
        "channel": "ops-team",
        "template": "alert_rca_notification",
        "include": ["rca_summary", "triaging_results"]
      },
      "condition": "",
      "requires_approval": false
    }
  ],
  "escalation": []
}
