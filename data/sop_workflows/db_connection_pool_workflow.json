{
  "sop_id": "SOP_DB_CONN_POOL",
  "alert_identifier": {
    "application": "payment-gateway",
    "domain": "database",
    "category": "connectivity",
    "severity": ["high"],
    "sop_identifier_keys": []
  },
  "triaging_steps": [
    {
      "step_id": 1,
      "action": "Query database connection error logs",
      "tool": "splunk_query",
      "tool_params": {
        "query": "index=app_logs host={host} (\"connection pool\" OR \"timeout\" OR \"connection refused\") earliest=-1h",
        "time_range": "1h"
      }
    },
    {
      "step_id": 2,
      "action": "Check active database connections trend",
      "tool": "prometheus_query",
      "tool_params": {
        "query": "db_pool_active_connections{instance='{host}'}",
        "step": "60s",
        "duration": "1h"
      }
    },
    {
      "step_id": 3,
      "action": "Check database query duration for slow queries",
      "tool": "prometheus_query",
      "tool_params": {
        "query": "histogram_quantile(0.99, rate(db_query_duration_seconds_bucket{instance='{host}'}[5m]))",
        "step": "60s",
        "duration": "1h"
      }
    },
    {
      "step_id": 4,
      "action": "Verify database endpoint health",
      "tool": "health_check",
      "tool_params": {
        "url": "https://{host}:5432/health",
        "timeout": 5
      }
    }
  ],
  "remediation_steps": [],
  "communication_steps": [
    {
      "step_id": 5,
      "action": "Send RCA notification to DB ops and app owners via Teams",
      "tool": "teams_message",
      "tool_params": {
        "channel": "db-ops-team",
        "template": "alert_rca_notification",
        "include": ["rca_summary", "triaging_results"]
      },
      "condition": "",
      "requires_approval": false
    }
  ],
  "escalation": []
}
